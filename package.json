{
  "name": "dolmir",
  "version": "0.1.0",
  "private": true,
  "description": "DOLMIR — AI-native operational control layer for companies. Platform monorepo.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages tests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project contract --project architecture",
    "test:evals": "vitest run --project evals",
    "clean": "rm -rf dist packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo *.tsbuildinfo"
  },
  "devDependencies": {
    "@dolmir/core": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
