# DOLMIR configuration — copy to .env for local development.
#
# Every variable is validated at boot (fail fast). A DOLMIR_* variable the
# schema does not know is a boot failure, so a typo cannot silently fall back
# to a default. Secrets are read only here, never from code elsewhere, and are
# never logged.

# development | test | production
DOLMIR_ENV=development
# debug | info | warn | error
DOLMIR_LOG_LEVEL=debug
# json | pretty   (default: pretty in development, json otherwise)
# DOLMIR_LOG_FORMAT=pretty

DOLMIR_HTTP_HOST=127.0.0.1
DOLMIR_HTTP_PORT=3000

# Runtime connection — MUST use the restricted role `dolmir_app` (cannot bypass RLS).
DOLMIR_DATABASE_URL=postgres://dolmir_app:dolmir_app_dev@localhost:5432/dolmir
# Migrations — the object-owning role. Not needed by the API at runtime.
DOLMIR_DATABASE_OWNER_URL=postgres://dolmir_owner:dolmir_owner_dev@localhost:5432/dolmir
DOLMIR_DATABASE_POOL_MAX=10

# Authentication — JWTs issued by Supabase Auth (or the local dev issuer).
# Exactly one of JWKS_URL (asymmetric) or HS256_SECRET (symmetric) must be set.
DOLMIR_AUTH_ISSUER=http://localhost:3000/dev-auth
DOLMIR_AUTH_AUDIENCE=dolmir
# DOLMIR_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
DOLMIR_AUTH_HS256_SECRET=dev-only-secret-change-me-please-32chars

# Object storage — memory | local
DOLMIR_STORAGE_DRIVER=local
DOLMIR_STORAGE_LOCAL_ROOT=.dolmir/storage

# AI provider — none | fake | anthropic
DOLMIR_AI_PROVIDER=none
# DOLMIR_AI_ANTHROPIC_API_KEY=
# DOLMIR_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Tier → model routing (Directive §19). Conservative defaults live in code.
# DOLMIR_AI_MODEL_FAST=
# DOLMIR_AI_MODEL_STANDARD=
# DOLMIR_AI_MODEL_DEEP=

# Test harness only (ignored by the configuration loader): a superuser connection
# used by integration tests to create throwaway databases, and an optional key to
# re-record the Anthropic contract cassettes from the live API.
# DOLMIR_TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# DOLMIR_TEST_ANTHROPIC_API_KEY=

# --- Connectors and jobs (Phase 2, ADR-0013 / ADR-0014) -----------------------
# 32 random bytes, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts per-tenant connector credentials. Required in production; without it
# connections cannot be created.
# DOLMIR_SECRETS_KEY=
# Background jobs: memory (development/tests) or pg-boss (production; required there).
DOLMIR_JOBS_DRIVER=memory
# PostgreSQL schema pg-boss owns; created by `dolmir jobs:migrate` with the owner connection.
DOLMIR_JOBS_SCHEMA=dolmir_jobs
# Mailbox provider: imap_smtp talks to a real server; fake keeps messages in
# memory so the whole chain can be exercised without one. Refused in production.
DOLMIR_MAILBOX_DRIVER=fake
