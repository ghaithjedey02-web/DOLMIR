{
  "name": "@dolmir/api",
  "version": "0.1.0",
  "private": true,
  "description": "DOLMIR Business Platform delivery: HTTP API, composition root and CLI.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dolmir": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "cli": "tsx --conditions=development src/cli/main.ts"
  },
  "dependencies": {
    "@dolmir/core": "workspace:*",
    "fastify": "5.12.1",
    "zod": "4.5.4"
  }
}
