{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/__fixtures__/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "references": [{ "path": "packages/core" }, { "path": "apps/api" }]
}
